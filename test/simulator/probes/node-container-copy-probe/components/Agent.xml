<?xml version="1.0" encoding="utf-8" ?>
<!--
  A custom component that keeps state in its script scope (`m`), set through a public function.
  Reading that state back is how the probe detects a copy that lost the scope: a node rebuilt by
  createFlatNode never runs init(), so `m` holds only top/global and readToken() answers "UNSET".
-->
<component name="Agent" extends="Node">
    <interface>
        <field id="marker" type="string" value="orig-marker" />
        <function name="configure" />
        <function name="readToken" />
    </interface>
    <script type="text/brightscript"><![CDATA[
    sub init()
        m.token = "init-default"
    end sub

    sub configure(token as String)
        m.token = token
    end sub

    function readToken() as String
        if m.token = invalid then return "UNSET"
        return m.token
    end function
    ]]></script>
</component>
