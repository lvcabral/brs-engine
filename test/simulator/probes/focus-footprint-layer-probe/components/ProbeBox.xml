<?xml version="1.0" encoding="utf-8" ?>
<!-- An opaque blue box with white text: a footprint drawn over it tints or hides it. -->
<component name="ProbeBox" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onSize" />
        <field id="height" type="float" onChange="onSize" />
    </interface>
    <children>
        <Rectangle id="box" color="0x3060C0FF" />
        <Label id="title" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
    </children>
    <script type="text/brightscript">
    <![CDATA[
    sub onContent()
        m.top.findNode("title").text = m.top.itemContent.title
    end sub

    sub onSize()
        for each id in ["box", "title"]
            node = m.top.findNode(id)
            node.width = m.top.width
            node.height = m.top.height
        end for
    end sub
    ]]>
    </script>
</component>
