<?xml version="1.0" encoding="utf-8" ?>
<!-- A view whose XML child focuses itself in its own init(): the view never links to it. -->
<component name="ChildView" extends="KeyGroup">
<children>
  <SelfKey id="child" />
</children>
<script type="text/brightscript"><![CDATA[
sub init()
    m.top.focusable = false
    m.top.consume = false
end sub
]]></script>
</component>
