<?xml version="1.0" encoding="utf-8" ?>
<component name="ProbeItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
    </interface>
    <children>
        <Rectangle id="box" width="200" height="80" color="0x3060C0FF" />
        <Label id="title" width="200" height="80" horizAlign="center" vertAlign="center" />
    </children>
    <script type="text/brightscript">
    <![CDATA[
    sub onContent()
        m.top.findNode("title").text = m.top.itemContent.title
    end sub
    ]]>
    </script>
</component>
